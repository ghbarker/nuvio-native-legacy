+  for (const char *p = ini; p < fim; p++) {
+    if (*p == '"') {
+      const char *nome = p + 1, *fecha = nome;
+      while (fecha < fim && *fecha != '"') {
+        if (*fecha == '\\' && fecha + 1 < fim) fecha++;
+        fecha++;

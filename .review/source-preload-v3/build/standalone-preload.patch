+    pararEstado(antigo);
+    s->isolado = 0;
+    estadoAtivo = s; // transfere a referencia do handle para a API ativa
+    *preparo = NULL;
+  }
+  pthread_mutex_unlock(&s->trava);
+  pthread_mutex_unlock(&ativoTrava);

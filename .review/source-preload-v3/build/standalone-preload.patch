+  p->candidatas = calloc((size_t)total, sizeof *p->candidatas);
+  ordem = malloc((size_t)total * sizeof *ordem); fila = malloc((size_t)total * sizeof *fila);
+  rank = malloc((size_t)total * sizeof *rank); pts = malloc((size_t)total * sizeof *pts);

+static const char *objetoRaiz(const char *p, const char *fim, const char *nome) {
+  const char *v = valorRaiz(p, fim, nome), *f;
+  if (!v || *v != '{' || !(f = js_fim(v)) || f <= v || f > fim || f[-1] != '}') return NULL;

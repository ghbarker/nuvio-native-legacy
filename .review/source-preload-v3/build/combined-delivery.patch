+    private fun soltarRecursosPreparo(r: RecursosPlayer) {
+        if (r.liberado) return
+        r.liberado = true
+        r.adotado = false
+        r.carga.cancelada = true
+        if (r.construido()) liberarEmFundo(r.p, null) { liberarFontePreparo(r) }
+        else liberarFontePreparo(r)
+        r.cache?.liberar()
+    }

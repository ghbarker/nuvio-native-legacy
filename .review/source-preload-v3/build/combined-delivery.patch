+            }
+        }
+        fun retomar(mediaSource: PreloadMediaSource): Boolean {
+            val d = s.duracaoFonteMs
+            if (!s.fonteBusca || d == C.TIME_UNSET || d <= 1000L) { falhou(); return false }
+            s.posicaoFonteMs = d * s.fracaoPendente / 10000L
+            s.fracaoPendente = 0
+            s.inicioAceito = true
+            s.faixasFonteProntas = false

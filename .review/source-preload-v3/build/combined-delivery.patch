+    char chave[FONTEFALHA_CHAVE]; fontefalha_addon_chave(a->base, chave, sizeof chave);
+    for (int q = 0; q < nFontes; q++) {
+      snprintf(fontes[q].addonChave, sizeof fontes[q].addonChave, "%s", chave);

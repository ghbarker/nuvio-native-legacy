+static void abrirLimiteProvedor(int servico) {
+  // The order sheet owns each provider's count; there is no duplicate row.
+  if (frAberta) key(SDLK_ESCAPE);
+  assert(!frAberta && !uxEditor);
+  abrir(AJ_FALHA_PROVEDOR_ORDEM); assert(frAberta == 4);
+  int linha = -1;
+  for (int i = 0; i < faN; i++) if (faItem[i].servico == servico) linha = i;
+  assert(linha >= 0);
+  for (int i = 0; i < linha; i++) key(SDLK_DOWN);
+  key(SDLK_RIGHT); key(SDLK_RIGHT); key(SDLK_RETURN);
+  assert(!frAberta && uxEditor == 1 && uxOp == AJ_FALHA_RD_LIMITE + servico);
+}

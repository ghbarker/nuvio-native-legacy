+  uint64_t v = 0;
+  for (size_t i = 0; i < n; i++) {
+    int d = hexDigito((unsigned char)texto[i]);
+    if (d < 0) return 0;
+    v = (v << 4) | (unsigned)d;
+  }
+  *saida = v; return 1;

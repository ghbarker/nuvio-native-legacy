+  int i, melhor = -1;
+  if (!eps || n < 1) return -1;
+  for (i = 0; i < n; i++) {
+    const CatEp *p = &eps[i];
+    if (p->episodio < 1 || p->temporada < 0) continue;
+    if (p->temporada == 0 && t > 0) continue;
+    if (p->temporada > t || (p->temporada == t && p->episodio >= e)) continue;
